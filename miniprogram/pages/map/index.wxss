.map-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 44rpx;
  background: linear-gradient(180deg, #edf3ff 0, #f6f8fc 420rpx, #f6f8fc 100%);
}

.hero {
  height: 126rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.year-picker {
  min-width: 142rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dce3f0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #35415a;
  font-size: 25rpx;
  font-weight: 600;
}

.picker-arrow {
  color: #7a879c;
}

.map-shell {
  position: relative;
  overflow: hidden;
  height: 700rpx;
  border-radius: 32rpx;
}

.map {
  width: 100%;
  height: 100%;
}

.empty-overlay {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 42rpx 36rpx;
  border: 1rpx solid rgba(226, 232, 243, 0.9);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  text-align: center;
  box-shadow: 0 18rpx 48rpx rgba(35, 54, 92, 0.12);
}

.empty-icon {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e8eeff;
  color: #2457e6;
  font-size: 38rpx;
}

.empty-title {
  font-size: 31rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 12rpx;
  color: #7f8ba0;
  font-size: 24rpx;
  line-height: 1.55;
}

.empty-action {
  display: inline-flex;
  margin-top: 26rpx;
  padding: 0 30rpx;
  height: 70rpx;
  align-items: center;
  border-radius: 999rpx;
  background: #2457e6;
  color: white;
  font-size: 25rpx;
  font-weight: 650;
}

.stats-card {
  margin-top: 24rpx;
  padding: 28rpx 16rpx;
  display: flex;
  align-items: center;
}

.stat-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-wide {
  flex: 1.35;
}

.stat-number {
  max-width: 190rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #172033;
  font-size: 34rpx;
  font-weight: 760;
}

.stat-label {
  margin-top: 7rpx;
  color: #8a95a8;
  font-size: 21rpx;
}

.stat-divider {
  width: 1rpx;
  height: 54rpx;
  background: #e6eaf1;
}

.route-note {
  margin: 24rpx 6rpx;
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
  color: #7b879a;
  font-size: 22rpx;
  line-height: 1.55;
}

.note-mark {
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #9aa7bb;
  border-radius: 50%;
  font-size: 20rpx;
}

.add-button {
  margin-top: 6rpx;
}

.plus {
  margin-right: 8rpx;
  font-size: 38rpx;
  font-weight: 400;
}
